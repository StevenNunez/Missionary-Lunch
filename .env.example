# --- Supabase (sin estas dos variables la app corre en modo demo local) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# --- Solo servidor (recordatorios y usuario demo) ---
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
CRON_SECRET=una_clave_larga_y_aleatoria
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# --- SMTP para los recordatorios por correo ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Missionary Lunch <avisos@tu-dominio.com>"

# --- Avisos push (npx web-push generate-vapid-keys). La privada nunca se comparte ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:avisos@tu-dominio.com

# --- Correo que recibe el aviso de barrios nuevos por aprobar ---
ADMIN_EMAIL=

# --- Usuario demo (npm run demo:seed) ---
DEMO_EMAIL=
